# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These are development credentials for a database bound to loopback only. They
# are still not committed: a seeded credential in a public submission repository
# is indistinguishable from demo data to a reviewer (threat EXT-03), and the
# habit of committing one is what eventually commits a real one.

# --- Postgres ---------------------------------------------------------------
# ordin_owner owns the schema and runs migrations. See docs/adr/0001.
POSTGRES_OWNER_USER=ordin_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
POSTGRES_DB=ordin
POSTGRES_HOST=127.0.0.1
# 5434, and every port below is deliberately non-default. This checkout is
# namespaced end to end (compose project ordin-build, containers ordin-build-*,
# volume ordin_build_pgdata) because a second checkout of this project shared a
# container with it once - identical container_name values, and those are globally
# unique in Docker. If you change these, change docker-compose.yml to match, and
# run `python tasks.py doctor`: it will tell you if you are pointed at a database
# this checkout did not migrate.
POSTGRES_PORT=5434

# ordin_app is the restricted role the api and worker connect as. It owns
# nothing, which is what makes slice 2's audit REVOKE mean anything.
ORDIN_APP_USER=ordin_app
ORDIN_APP_PASSWORD=change_me_app

# --- API --------------------------------------------------------------------
ORDIN_ENV=dev
ORDIN_LOG_LEVEL=INFO
ORDIN_API_HOST=127.0.0.1
ORDIN_API_PORT=8001

# Signs session tokens (ADR 0002). Generate your own; never commit a real one.
ORDIN_SESSION_SECRET=change_me_session_secret
ORDIN_WEB_PORT=3001

# --- Bootstrap administrator (optional) --------------------------------------
# The first administrator cannot be created through an administration screen that
# requires an administrator. `python tasks.py admin` closes that hole from the
# command line. Setting these also lets `python tasks.py demo` restore the account
# after it reseeds, instead of locking the operator out of their own system.
#
# An administrator holds an administrative *post*, not a personal flag, and carries
# no case designation: it places people and reads no evidence.
ORDIN_ADMIN_EMAIL=
ORDIN_ADMIN_PASSWORD=
ORDIN_ADMIN_NAME=Administrator
