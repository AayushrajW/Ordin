# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These are development credentials for a database bound to loopback only. They
# are still not committed: a seeded credential in a public submission repository
# is indistinguishable from demo data to a reviewer (threat EXT-03), and the
# habit of committing one is what eventually commits a real one.

# --- Postgres ---------------------------------------------------------------
# ordin_owner owns the schema and runs migrations. See docs/adr/0001.
POSTGRES_OWNER_USER=ordin_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
POSTGRES_DB=ordin
POSTGRES_HOST=127.0.0.1
# 5433, not 5432: a pre-existing PostgreSQL 17 service may already hold 5432.
POSTGRES_PORT=5433

# ordin_app is the restricted role the api and worker connect as. It owns
# nothing, which is what makes slice 2's audit REVOKE mean anything.
ORDIN_APP_USER=ordin_app
ORDIN_APP_PASSWORD=change_me_app

# --- API --------------------------------------------------------------------
ORDIN_ENV=dev
ORDIN_LOG_LEVEL=INFO
ORDIN_API_HOST=127.0.0.1
ORDIN_API_PORT=8000

# Signs session tokens (ADR 0002). Generate your own; never commit a real one.
ORDIN_SESSION_SECRET=change_me_session_secret
