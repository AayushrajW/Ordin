.env
.env.*
# ...but the template must be committed: it is the only record of what
# configuration the project needs.
!.env.example
*.pem
*.key
__pycache__/
node_modules/
.venv/
data/
*.egg-info/

# Next.js build output and TypeScript incremental state. Regenerated by
# `npm run build`; committing it puts ~250 generated files in every diff.
web/.next/
web/out/
*.tsbuildinfo

# Generated fixture documents. Deterministic (there is a test), so they are
# regenerated with `python tasks.py fixtures` rather than carried in git.
fixtures/corpus/

# Content-addressed blob store for the dev loop. These are document bytes; they are
# regenerated by running the pipeline and must never be committed.
var/

# Next 16 writes these into web/ on first run. agentRules:false stops it; the ignore
# is belt and braces, because a CLAUDE.md here would shadow the project's own.
web/CLAUDE.md
web/AGENTS.md

# Submission archives built by `python tasks.py package`. Regenerated from git;
# committing one would commit a copy of the repository into the repository.
dist/
