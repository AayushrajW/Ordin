.env
.env.*
# ...but the template must be committed: it is the only record of what
# configuration the project needs.
!.env.example
*.pem
*.key
__pycache__/
node_modules/
.venv/
data/
*.egg-info/

# Next.js build output and TypeScript incremental state. Regenerated by
# `npm run build`; committing it puts ~250 generated files in every diff.
web/.next/
web/out/
*.tsbuildinfo

# Generated fixture documents. Deterministic (there is a test), so they are
# regenerated with `python tasks.py fixtures` rather than carried in git.
fixtures/corpus/
